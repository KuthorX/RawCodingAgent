# Any OpenAI-compatible Chat Completions endpoint (OpenAI / DeepSeek / Qwen / Kimi ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# true if the model accepts images (e.g. a Qwen-VL / Kimi vision / gpt-4o model). deepseek-chat is text-only:
# pasted images are then saved and the model is only told their file paths.
# OPENAI_VISION=true

# Max model calls per turn; 0 = no limit (default).
AGENT_MAX_STEPS=0
# Per-turn guards (D1): stop when one turn costs more than this (USD, 0 = off),
# or when the same tool call is made this many times in a row. Either way the model
# is asked for a short summary before the turn ends.
AGENT_MAX_TURN_COST_USD=0.5
AGENT_MAX_REPEATS=3
# Extra system prompt rules (D3): debug, efficient, tools, spec. Default "spec,tools"; empty = bare baseline.
# AGENT_PROMPT_RULES=spec,tools

# web_search tool (https://tavily.com, free tier 1000 searches/month). Leave empty to run without it.
# The key is removed from the environment the agent's bash sees. The eval never uses web search.
TAVILY_API_KEY=

# --- pricing, USD per 1M tokens (used for cost in stats and eval budgets) ---
# Defaults: deepseek-flash peak prices (https://api-docs.deepseek.com/quick_start/pricing, checked 2026-10-20).
PRICE_INPUT_PER_MTOK=0.30
PRICE_CACHED_INPUT_PER_MTOK=0.006
PRICE_OUTPUT_PER_MTOK=1.20

# --- public access through Cloudflare Tunnel + Access (npm run gui -- --public; README: 从公网访问) ---
# The public address, served by your cloudflared tunnel.
# PUBLIC_ORIGIN=https://agent.example.com
# Zero Trust team name (or https://<team>.cloudflareaccess.com) and the Access application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN=myteam
# CF_ACCESS_AUD=
# Accounts allowed in, comma separated; checked again here even though the Access policy already filters.
# PUBLIC_ALLOWED_EMAILS=me@example.com
