# Optional legacy Chat Completions endpoint. Native vendor keys and new-session defaults can be
# configured in the GUI. Keys saved there live in ~/.raw-coding-agent/providers.json (0600), not in sessions.
# These environment credentials belong ONLY to the legacy profile, never to another native provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# true if the model accepts images (e.g. a Qwen-VL / Kimi vision / gpt-4o model). deepseek-chat is text-only:
# pasted images are then saved and the model is only told their file paths.
# OPENAI_VISION=true
# Streamed replies (default on). Set false for an endpoint that rejects stream_options; the provider also falls
# back to a normal request automatically when streaming fails before any text arrived.
# OPENAI_STREAM=false
# For native Pi providers this flag controls UI deltas; the underlying transport remains streaming.

# Max model calls per turn; 0 = no limit (default).
AGENT_MAX_STEPS=0
# Per-turn guards (D1): stop when one turn costs more than this (USD, 0 = off),
# or when the same tool call is made this many times in a row. A cost stop uses a
# local notice; other limits request a summary only while spending budget remains.
AGENT_MAX_TURN_COST_USD=0.5
AGENT_MAX_REPEATS=3
# Alternating cycles are also checked: 2-6 calls with unchanged results, three cycles before a warning,
# then one more cycle before stopping. New evidence, file edits and user steering reset that detector.
# Extra system prompt rules (D3): debug, efficient, tools, spec. Default "spec,tools"; empty = bare baseline.
# AGENT_PROMPT_RULES=spec,tools

# web_search tool (https://tavily.com, free tier 1000 searches/month). Leave empty to run without it.
# The key is removed from the environment the agent's bash sees. The eval never uses web search.
TAVILY_API_KEY=

# --- legacy endpoint pricing, USD per 1M tokens ---
# Native Pi providers supply per-request catalog estimates, including cached writes and reasoning usage.
# Defaults: deepseek-flash peak prices (https://api-docs.deepseek.com/quick_start/pricing, checked 2026-10-20).
PRICE_INPUT_PER_MTOK=0.30
PRICE_CACHED_INPUT_PER_MTOK=0.006
PRICE_OUTPUT_PER_MTOK=1.20
# Optional exact per-model rates, JSON object keyed by model id. Missing fields use base PRICE_* values.
# MODEL_PRICING_JSON={"deepseek-chat":{"inputPerMTok":0.30,"cachedInputPerMTok":0.006,"outputPerMTok":1.20}}
# Optional per-model context limits. Unknown models default to 64000. Output space is reserved;
# each complete request is checked, and compaction uses the smaller input budget / GUI threshold.
# MODEL_CONTEXT_WINDOWS_JSON={"deepseek-chat":64000}
# Optional per-model vision capability map; OPENAI_VISION=true still forces vision for every model.
# MODEL_VISION_JSON={"qwen-vl-max":true,"deepseek-chat":false}

# --- public access through Cloudflare Tunnel + Access (npm run gui -- --public; README: 从公网访问) ---
# The public address, served by your cloudflared tunnel.
# PUBLIC_ORIGIN=https://agent.example.com
# Zero Trust team name (or https://<team>.cloudflareaccess.com) and the Access application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN=myteam
# CF_ACCESS_AUD=
# Accounts allowed in, comma separated; checked again here even though the Access policy already filters.
# PUBLIC_ALLOWED_EMAILS=me@example.com
